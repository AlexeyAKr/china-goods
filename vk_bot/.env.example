# ===== GIGACHAT API =====
# Авторизационный ключ GigaChat API
# Получить: https://developers.sber.ru/studio/ → проект GigaChat API → Настройки API → Получить ключ
# Значение = base64(Client ID:Client Secret)
GIGACHAT_CREDENTIALS=

# Область доступа для физических лиц
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat (например: GigaChat-2-Pro, GigaChat-2-Max; старые имена, вроде GigaChat, устарели)
GIGACHAT_MODEL=GigaChat-2-Max

# Проверка TLS-сертификата (true — проверять, false — отключить из-за сертификатов НУЦ Минцифры)
GIGACHAT_VERIFY_SSL_CERTS=

# ===== VK API =====
# Токен сообщества ВКонтакте
# Получить: Управление сообществом → Работа с API → Ключи доступа → Создать ключ
VK_TOKEN=

# ID сообщества ВКонтакте (только цифры, без минуса)
VK_GROUP_ID=241598165